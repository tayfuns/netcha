# Use environment variable double underscores for nested ASP.NET Core settings.
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5080

# Required in Production. Use a random value with at least 32 UTF-8 bytes.
Captcha__HmacKey=replace-with-a-long-random-secret
Captcha__MaxNumber=100000
Captcha__ExpiresInSeconds=300

# Optional. Leave blank to use in-process memory stores for local development.
Redis__ConnectionString=
Redis__FallbackToMemory=true
Persistence__ConnectionString=
Persistence__AutoMigrate=true

# One-time bootstrap password for the first `admin` database user. Remove after
# the first migration and password change in the administration panel.
Admin__ApiKey=replace-with-a-long-random-admin-key
Admin__SessionHours=8

# Arrays are indexed in environment variables.
Cors__AllowedOrigins__0=http://localhost:5173
Cors__AllowedOrigins__1=https://tayfuns.github.io
