{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Captcha": {
    "MaxNumber": 100000,
    "ExpiresInSeconds": 300
  },
  "Redis": {
    "FallbackToMemory": true,
    "KeyPrefix": "netcha"
  },
  "Persistence": {
    "AutoMigrate": true,
    "FallbackToMemory": true
  },
  "Cors": {
    "AllowedOrigins": []
  }
}
